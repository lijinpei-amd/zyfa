From 282bb0968039969c966a43e7bdd937bf7930191b Mon Sep 17 00:00:00 2001
From: Li Jinpei <jinpli@amd.com>
Date: Wed, 11 Nov 2026 22:44:28 +0800
Subject: [PATCH 2/2] [MachineLICM] Honor llvm.licm.disable loop metadata

LICM skips a loop whose loop ID carries llvm.licm.disable, but
MachineLICM still hoists out of it. In particular it hoists the
S_MOV_B32/V_MOV_B32 immediates that instruction selection materializes
for each use. IR LICM never sees those because constants are not
instructions, so the metadata cannot keep them in the loop.

Read the metadata through MachineLoop::getLoopID, as MachinePipeliner
does for llvm.loop.pipeline.disable. An instruction is hoisted to the
preheader of a loop only if neither that loop nor any loop between it
and the instruction is marked; inner unmarked loops still hoist to their
own preheaders. This applies to the pre- and post-RA passes.

Assisted-by: Claude Opus 5.5
---
 llvm/lib/CodeGen/MachineLICM.cpp              | 27 ++++++++++++++++---
 .../machinelicm-licm-disable-postra.mir       | 12 ++++-----
 .../AMDGPU/machinelicm-licm-disable.mir       |  6 ++---
 3 files changed, 33 insertions(+), 12 deletions(-)

diff --git a/llvm/lib/CodeGen/MachineLICM.cpp b/llvm/lib/CodeGen/MachineLICM.cpp
index 50d910f3b74c..e3e523bd5a98 100644
--- a/llvm/lib/CodeGen/MachineLICM.cpp
+++ b/llvm/lib/CodeGen/MachineLICM.cpp
@@ -22,6 +22,7 @@
 #include "llvm/ADT/SmallVector.h"
 #include "llvm/ADT/Statistic.h"
 #include "llvm/Analysis/AliasAnalysis.h"
+#include "llvm/Analysis/LoopInfo.h"
 #include "llvm/CodeGen/LazyMachineBlockFrequencyInfo.h"
 #include "llvm/CodeGen/MachineBasicBlock.h"
 #include "llvm/CodeGen/MachineBlockFrequencyInfo.h"
@@ -436,6 +437,19 @@ bool MachineLICMImpl::run(MachineFunction &MF) {
   return Changed;
 }
 
+/// Return the outermost loop that code in \p MBB can be hoisted out of without
+/// leaving a loop marked with llvm.licm.disable.
+static MachineLoop *getOutermostHoistableLoop(const MachineLoopInfo &MLI,
+                                              const MachineBasicBlock *MBB) {
+  MachineLoop *Outermost = nullptr;
+  for (MachineLoop *L = MLI.getLoopFor(MBB); L; L = L->getParentLoop()) {
+    if (findOptionMDForLoopID(L->getLoopID(), "llvm.licm.disable"))
+      break;
+    Outermost = L;
+  }
+  return Outermost;
+}
+
 /// Return true if instruction stores to the specified frame.
 static bool InstructionStoresToFI(const MachineInstr *MI, int FI) {
   // Check mayStore before memory operands so that e.g. DBG_VALUEs will return
@@ -692,6 +706,9 @@ void MachineLICMImpl::HoistRegionPostRA(MachineLoop *CurLoop) {
       continue;
 
     MachineInstr *MI = Candidate.MI;
+    if (getOutermostHoistableLoop(*MLI, MI->getParent()) != CurLoop)
+      continue;
+
     for (const MachineOperand &MO : MI->all_uses()) {
       if (!MO.getReg())
         continue;
@@ -886,15 +903,19 @@ void MachineLICMImpl::HoistOutOfLoop(MachineDomTreeNode *HeaderN,
 
     // Process the block
     GuaranteedToExecute.clear();
+    MachineLoop *HoistableLoop = getOutermostHoistableLoop(*MLI, MBB);
+    MachineLoop *StopLoop =
+        HoistableLoop ? HoistableLoop->getParentLoop() : MLI->getLoopFor(MBB);
     for (MachineInstr &MI : llvm::make_early_inc_range(*MBB)) {
       unsigned HoistRes = HoistResult::NotHoisted;
-      HoistRes = Hoist(&MI, Preheader, CurLoop);
+      if (HoistableLoop == CurLoop)
+        HoistRes = Hoist(&MI, Preheader, CurLoop);
       if (HoistRes & HoistResult::NotHoisted) {
         // We have failed to hoist MI to outermost loop's preheader. If MI is in
         // a subloop, try to hoist it to subloop's preheader.
         SmallVector<MachineLoop *> InnerLoopWorkList;
-        for (MachineLoop *L = MLI->getLoopFor(MI.getParent()); L != CurLoop;
-             L = L->getParentLoop())
+        for (MachineLoop *L = MLI->getLoopFor(MI.getParent());
+             L != CurLoop && L != StopLoop; L = L->getParentLoop())
           InnerLoopWorkList.push_back(L);
 
         while (!InnerLoopWorkList.empty()) {
