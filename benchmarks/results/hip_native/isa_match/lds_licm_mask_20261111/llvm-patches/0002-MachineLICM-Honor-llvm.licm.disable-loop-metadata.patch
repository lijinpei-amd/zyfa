   ; CHECK-NEXT: {{  $}}
   ; CHECK-NEXT: bb.2.inner:
   ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
-  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2, $sgpr1
+  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2
   ; CHECK-NEXT: {{  $}}
+  ; CHECK-NEXT:   $sgpr1 = S_MOV_B32 1234
   ; CHECK-NEXT:   $sgpr2 = S_ADD_U32 $sgpr2, $sgpr1, implicit-def dead $scc
   ; CHECK-NEXT:   S_CMP_LG_U32 $sgpr2, $sgpr0, implicit-def $scc
   ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
@@ -151,7 +151,7 @@ body: |
   ; CHECK-NEXT: {{  $}}
   ; CHECK-NEXT: bb.3.latch:
   ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.4(0x40000000)
-  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2, $sgpr1
+  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2
   ; CHECK-NEXT: {{  $}}
   ; CHECK-NEXT:   S_CMP_LG_U32 $sgpr2, 0, implicit-def $scc
   ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
