+    br label %inner
+
+  inner:
+    br i1 poison, label %inner, label %latch, !llvm.loop !2
+
+  latch:
+    br i1 poison, label %outer, label %exit
+
+  exit:
+    ret void
+  }
+
+  !0 = distinct !{!0, !1}
+  !1 = !{!"llvm.licm.disable"}
+  !2 = distinct !{!2, !1}
