+--- |
+  define amdgpu_kernel void @hoist() {
+  entry:
+    br label %loop
+
+  loop:
+    br i1 poison, label %loop, label %exit
+
+  exit:
+    ret void
+  }
+
+  define amdgpu_kernel void @licm_disable() {
+  entry:
