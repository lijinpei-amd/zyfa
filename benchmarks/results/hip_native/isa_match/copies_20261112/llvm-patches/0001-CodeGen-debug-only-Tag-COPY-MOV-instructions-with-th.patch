diff --git a/llvm/lib/CodeGen/ExpandPostRAPseudos.cpp b/llvm/lib/CodeGen/ExpandPostRAPseudos.cpp
index fb65500e7dc7..3e672d20ef06 100644
--- a/llvm/lib/CodeGen/ExpandPostRAPseudos.cpp
+++ b/llvm/lib/CodeGen/ExpandPostRAPseudos.cpp
@@ -12,6 +12,7 @@
 //===----------------------------------------------------------------------===//
 
 #include "llvm/CodeGen/ExpandPostRAPseudos.h"
+#include "llvm/CodeGen/CopyOrigin.h"
 #include "llvm/CodeGen/MachineDominators.h"
 #include "llvm/CodeGen/MachineFunctionPass.h"
 #include "llvm/CodeGen/MachineInstr.h"
@@ -134,9 +135,26 @@ bool ExpandPostRA::run(MachineFunction &MF) {
       if (!MI.isPseudo())
         continue;
 
+      std::string OriginTag;
+      MachineInstr *OriginPrev = MI.getPrevNode();
+      MachineInstr *OriginNext = MI.getNextNode();
+      if (const std::string *T = copyorigin::get(&MI))
+        OriginTag = *T;
+      auto TagExpansion = [&]() {
+        if (OriginTag.empty())
+          return;
+        MachineBasicBlock::iterator B =
+            OriginPrev ? std::next(OriginPrev->getIterator()) : MBB.begin();
+        MachineBasicBlock::iterator E =
+            OriginNext ? OriginNext->getIterator() : MBB.end();
+        for (MachineBasicBlock::iterator I = B; I != E; ++I)
+          copyorigin::set(&*I, OriginTag);
+      };
+
       // Give targets a chance to expand even standard pseudos.
       if (TII->expandPostRAPseudo(MI)) {
         MadeChange = true;
+        TagExpansion();
         continue;
       }
 
@@ -148,6 +166,7 @@ bool ExpandPostRA::run(MachineFunction &MF) {
       case TargetOpcode::COPY:
         TII->lowerCopy(&MI);
         MadeChange = true;
+        TagExpansion();
         break;
       case TargetOpcode::DBG_VALUE:
         continue;
