@@ -172,3 +180,42 @@ void MachineFunctionPass::getAnalysisUsage(AnalysisUsage &AU) const {
 
   FunctionPass::getAnalysisUsage(AU);
 }
+
+static llvm::cl::opt<bool> EnableCopyOrigin("copy-origin", llvm::cl::Hidden,
+                                            llvm::cl::init(false));
+static std::unordered_map<const llvm::MachineInstr *, std::string> &originMap() {
+  static std::unordered_map<const llvm::MachineInstr *, std::string> M;
+  return M;
+}
+bool llvm::copyorigin::enabled() { return EnableCopyOrigin; }
+std::string &llvm::copyorigin::context() {
+  static std::string C;
+  return C;
+}
+void llvm::copyorigin::set(const MachineInstr *MI, const std::string &Note) {
+  if (EnableCopyOrigin)
+    originMap()[MI] = Note;
+}
+void llvm::copyorigin::setIfAbsent(const MachineInstr *MI,
+                                   const std::string &Note) {
+  if (EnableCopyOrigin)
+    originMap().emplace(MI, Note);
+}
+const std::string *llvm::copyorigin::get(const MachineInstr *MI) {
+  if (!EnableCopyOrigin)
+    return nullptr;
+  auto It = originMap().find(MI);
+  return It == originMap().end() ? nullptr : &It->second;
+}
+void llvm::copyorigin::clearAll() { originMap().clear(); }
+void llvm::copyorigin::erase(const MachineInstr *MI) {
+  if (EnableCopyOrigin)
+    originMap().erase(MI);
+}
+void llvm::copyorigin::tagUntagged(MachineFunction &MF, StringRef PassName) {
+  const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+  for (MachineBasicBlock &MBB : MF)
+    for (MachineInstr &MI : MBB.instrs())
+      if (MI.isCopy() || TII->getName(MI.getOpcode()).contains("MOV"))
+        originMap().emplace(&MI, ("pass:" + PassName).str());
+}
