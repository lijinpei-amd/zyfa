diff --git a/llvm/include/llvm/CodeGen/CopyOrigin.h b/llvm/include/llvm/CodeGen/CopyOrigin.h
new file mode 100644
index 000000000000..7fe460a6d910
--- /dev/null
+++ b/llvm/include/llvm/CodeGen/CopyOrigin.h
@@ -0,0 +1,20 @@
+//===- CopyOrigin.h - Debug-only COPY provenance side table ----*- C++ -*-===//
+#ifndef LLVM_CODEGEN_COPYORIGIN_H
+#define LLVM_CODEGEN_COPYORIGIN_H
+#include <string>
+namespace llvm {
+class MachineInstr;
+class MachineFunction;
+class StringRef;
+namespace copyorigin {
+bool enabled();
+void set(const MachineInstr *MI, const std::string &Note);
+void setIfAbsent(const MachineInstr *MI, const std::string &Note);
+const std::string *get(const MachineInstr *MI);
+void erase(const MachineInstr *MI);
+void clearAll();
+void tagUntagged(MachineFunction &MF, StringRef PassName);
+std::string &context();
+} // namespace copyorigin
+} // namespace llvm
+#endif
