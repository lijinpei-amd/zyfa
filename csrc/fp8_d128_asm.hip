// FP8 (e4m3) causal forward attention, d_qk = d_v = 128: host side of the hand-scheduled assembly kernel (generated by
// csrc/asm/d128.py, built by csrc/asm/build.py). Same interface and outputs as fmha_fp8_d128::forward.
#include <ATen/hip/HIPContext.h>
#include <hip/hip_runtime.h>
#include <torch/extension.h>
#include <c10/hip/HIPGuard.h>
#include <ATen/hip/HIPGraphsUtils.cuh>

#include <cstring>
#include <map>
#include <mutex>
#include <tuple>
#include <vector>

#include "descale.h"
#include "fp8_native.h"
#include "generated/fmha_fp8_d128_pp_co.h"
#include "xcd_map.h"

namespace fmha_fp8_d128 {   // HIP kernel (fp8_d128.hip)
std::vector<torch::Tensor> forward(torch::Tensor q, torch::Tensor k, torch::Tensor v, double scale, bool causal,
                                   bool return_lse, bool bshd, double v_scale, const float *q_descale,
                                   const float *k_descale, const float *v_descale);
}

namespace fmha_fp8_d128_asm {

// Kernel argument block (dword offsets match d128.KA). The kernel multiplies c8 and sl2 by q_descale * k_descale and
// the output by v_descale * v_scale; a null descale pointer reads as 1.
using Args = fmha_fp8_native::Args128;
static_assert(sizeof(Args) == 152, "kernarg block is 152 bytes");
static_assert(offsetof(Args, c8) == 48 && offsetof(Args, n_jobs) == 60 && offsetof(Args, grid) == 104 &&
                  offsetof(Args, v_scale) == 108 && offsetof(Args, q_descale) == 128 &&
                  offsetof(Args, v_descale) == 144,
              "kernarg layout");

constexpr float L2E = 1.4426950408889634f;
constexpr float LEAN_BIAS = 0.35f;

// Per-shape launch plan: grid, strides and the job table (one entry per job: q pair index, LSE row offset, Q / KV / O
// byte offsets), built on the host with the HIP kernels' job order.
struct Plan {
    torch::Tensor tab;
    int n_jobs, num_q, qw, pair, grid;
    uint32_t q_ss, kv_ss, o_ss, q_sh, o_sh;
};

using PlanKey = std::tuple<int, int, int, int, int, int, int, int>;   // device, B, Hq, Hkv, M, bshd, nxcd, cus
static std::map<PlanKey, Plan> g_plans;
static std::map<int, hipFunction_t> g_fn;
static std::mutex g_mu;

static hipFunction_t kernel_fn(int dev) {
    auto it = g_fn.find(dev);
    if (it != g_fn.end())
        return it->second;
    hipModule_t mod;
    TORCH_CHECK(hipModuleLoadData(&mod, kFmhaFp8D128PP) == hipSuccess, "fmha_fp8 asm: hipModuleLoadData failed");
    hipFunction_t fn;
    TORCH_CHECK(hipModuleGetFunction(&fn, mod, "fmha_fp8pp") == hipSuccess, "fmha_fp8 asm: no fmha_fp8pp symbol");
    g_fn[dev] = fn;
    return fn;
}

static const Plan &plan(int dev, int B, int Hq, int Hkv, int M, bool bshd) {
    const int nxcd = fmha_num_xcds(), cus = fmha_num_cus();
    const PlanKey key{dev, B, Hq, Hkv, M, bshd ? 1 : 0, nxcd, cus};
    auto it = g_plans.find(key);
    if (it != g_plans.end())
        return it->second;
    constexpr int D = 128, Dv = 128;
    const int N = M, group = Hq / Hkv;
    const bool pair = group >= 2 && group % 2 == 0;
    const int qw = pair ? 4 : 8;
    const int num_q = (M / 32 + qw - 1) / qw;
    const int nq_pairs = (num_q + 1) / 2;
    const int nheads = pair ? Hq / 2 : Hq;
    const int n_head_units = nheads * B;
    const int n_jobs = nq_pairs * n_head_units;
    Plan p;
    p.n_jobs = n_jobs;
    p.num_q = num_q;
    p.qw = qw;
    p.pair = pair ? 1 : 0;
    p.grid = fmha_persist_grid(n_jobs, nxcd);
    uint64_t q_sh, q_sb, kv_sh, kv_sb, o_sh, o_sb;
    if (bshd) {
        p.q_ss = Hq * D, q_sh = D, q_sb = (uint64_t)M * Hq * D;
        p.kv_ss = Hkv * D, kv_sh = D, kv_sb = (uint64_t)N * Hkv * D;
        p.o_ss = Hq * Dv * 2, o_sh = Dv * 2, o_sb = (uint64_t)M * Hq * Dv * 2;
    } else {
        p.q_ss = D, q_sh = (uint64_t)M * D, q_sb = (uint64_t)Hq * M * D;
        p.kv_ss = D, kv_sh = (uint64_t)N * D, kv_sb = (uint64_t)Hkv * N * D;
        p.o_ss = Dv * 2, o_sh = (uint64_t)M * Dv * 2, o_sb = (uint64_t)Hq * M * Dv * 2;
    }
    p.q_sh = (uint32_t)q_sh;
    p.o_sh = (uint32_t)o_sh;
    std::vector<uint32_t> tab((size_t)n_jobs * 8);
    for (int j = 0; j < n_jobs; ++j) {
        int qx, hu;
        fmha_xcd_map(nq_pairs, n_head_units, nxcd, qx, hu, j);
        int b, hq0, hkv;
        if (pair) {
            const int ppk = group / 2, upb = Hkv * ppk;
            b = hu / upb;
            const int u = hu - b * upb;
            hkv = u / ppk;
            hq0 = hkv * group + (u - hkv * ppk) * 2;
        } else {
            b = hu / Hq;
            hq0 = hu - b * Hq;
            hkv = hq0 / group;
        }
        const uint64_t q_off = b * q_sb + hq0 * q_sh, kv_off = b * kv_sb + hkv * kv_sh, o_off = b * o_sb + hq0 * o_sh;
        const uint64_t lse_off = ((uint64_t)b * Hq + hq0) * M;
        uint32_t *e = &tab[(size_t)j * 8];
        e[0] = qx;
        e[1] = (uint32_t)lse_off;
        e[2] = (uint32_t)q_off, e[3] = (uint32_t)(q_off >> 32);
        e[4] = (uint32_t)kv_off, e[5] = (uint32_t)(kv_off >> 32);
        e[6] = (uint32_t)o_off, e[7] = (uint32_t)(o_off >> 32);
    }
    TORCH_CHECK(at::cuda::currentStreamCaptureStatus() == at::cuda::CaptureStatus::None,
                "fmha_fp8 asm: the first call for a new shape builds its job table (a host-to-device copy), which a "
                "graph capture cannot record; call it once with this shape before capturing");
    p.tab = torch::from_blob(tab.data(), {(long)tab.size()}, torch::TensorOptions().dtype(torch::kInt32))
                .to(torch::Device(torch::kCUDA, dev));
    return g_plans.emplace(key, std::move(p)).first->second;
}

static std::vector<torch::Tensor> forward_impl(torch::Tensor q, torch::Tensor k, torch::Tensor v, double scale, bool causal,
                                   bool return_lse, bool bshd, double v_scale,
                                   c10::optional<torch::Tensor> q_descale, c10::optional<torch::Tensor> k_descale,
                                   c10::optional<torch::Tensor> v_descale, bool native) {
    TORCH_CHECK(causal, "fmha_fp8 is causal-only");
    TORCH_CHECK(q.is_cuda() && k.is_cuda() && v.is_cuda());
    TORCH_CHECK(k.device() == q.device() && v.device() == q.device(), "q, k, v must be on the same device");
    // Launches, module loads and job tables use q's device.
    const c10::cuda::OptionalCUDAGuard device_guard(q.device());
    TORCH_CHECK(q.scalar_type() == at::kFloat8_e4m3fn && k.scalar_type() == at::kFloat8_e4m3fn &&
                    v.scalar_type() == at::kFloat8_e4m3fn,
                "fmha_fp8 needs float8_e4m3fn");
    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4,
                bshd ? "q,k,v must be BSHD [B,S,H,D]" : "q,k,v must be BHSD [B,H,S,D]");
    q = q.contiguous();
    k = k.contiguous();
    v = v.contiguous();
    const int B = q.size(0), D = q.size(3), Dv = v.size(3);
    const int Hq = bshd ? q.size(2) : q.size(1);
    const int M = bshd ? q.size(1) : q.size(2);
    const int Hkv = bshd ? k.size(2) : k.size(1);
    const int N = bshd ? k.size(1) : k.size(2);
    TORCH_CHECK(D == 128 && Dv == 128 && M % 256 == 0 && N % 128 == 0);
    TORCH_CHECK(M == N && scale > 0, "fmha_fp8 needs M == N and scale > 0");
    TORCH_CHECK(fmha_scale_fp8_ok(scale), "fmha_fp8 needs a positive normal fp32 scale");
    fmha_check_v_scale(v_scale);
    const float *qd = fmha_descale_ptr(q_descale, q, "q_descale"), *kd = fmha_descale_ptr(k_descale, q, "k_descale"),
                *vd = fmha_descale_ptr(v_descale, q, "v_descale");
    TORCH_CHECK(Hkv > 0 && Hq % Hkv == 0 && k.size(3) == D && q.size(0) == k.size(0) && q.size(0) == v.size(0));
    if (bshd) {
        TORCH_CHECK(v.size(1) == N && v.size(2) == Hkv);
    } else {
        TORCH_CHECK(v.size(1) == Hkv && v.size(2) == N);
    }
    // The kernel forms row and tile byte offsets in 32 bits; larger shapes run the HIP kernel (same arithmetic).
    {
        const uint64_t lim = 1ull << 32;
        const uint64_t spans[] = {(uint64_t)M * (bshd ? Hq : 1) * 128, (uint64_t)M * (bshd ? Hq : 1) * Dv * 2,
                                  (uint64_t)N * (bshd ? Hkv : 1) * 128, (uint64_t)B * Hq * M * 4};
        for (uint64_t x : spans)
            if (x >= lim) {
                TORCH_CHECK(!native, "fmha_fp8 native HIP needs row and tile spans below 4 GiB");
                return fmha_fp8_d128::forward(q, k, v, scale, causal, return_lse, bshd, v_scale, qd, kd, vd);
            }
    }
    auto O = bshd ? torch::empty({B, M, Hq, Dv}, q.options().dtype(at::kBFloat16))
                  : torch::empty({B, Hq, M, Dv}, q.options().dtype(at::kBFloat16));
    torch::Tensor Lse;
    if (return_lse)
        Lse = torch::empty({B * Hq, M}, q.options().dtype(at::kFloat));
    if (B == 0 || Hq == 0 || M == 0)
        return return_lse ? std::vector<torch::Tensor>{O, Lse} : std::vector<torch::Tensor>{O};
    const int dev = q.get_device();
    hipFunction_t fn = nullptr;
    const Plan *p;
    {
        std::lock_guard<std::mutex> lock(g_mu);
        if (!native)
            fn = kernel_fn(dev);
        p = &plan(dev, B, Hq, Hkv, M, bshd);
    }
    // Same scale arithmetic as fmha_fp8_d128::forward (scale * log2(e) in fp32, then the lean code constants).
    const float sl2 = (float)scale * L2E;
    const float c8 = 8.f * sl2;
    const float b8k = 8.f * 6.f + 56.f - LEAN_BIAS;
    Args a;
    std::memset(&a, 0, sizeof(a));
    a.q = q.data_ptr();
    a.k = k.data_ptr();
    a.v = v.data_ptr();
    a.o = O.data_ptr();
    a.lse = return_lse ? Lse.data_ptr() : nullptr;
    a.tab = p->tab.data_ptr();
    a.c8 = c8;
    a.sl2 = sl2;
    a.b8k = b8k;
    a.n_jobs = p->n_jobs;
    a.num_q = p->num_q;
    a.qw = p->qw;
    a.pair = p->pair;
    a.q_ss = p->q_ss;
    a.kv_ss = p->kv_ss;
    a.o_ss = p->o_ss;
    a.q_sh2 = p->q_sh;
    a.o_sh2 = p->o_sh;
    a.l_sh2 = M;
    a.n_keys = N;
    a.grid = p->grid;
    a.v_scale = (float)v_scale;
    a.q_descale = qd;
    a.k_descale = kd;
    a.v_descale = vd;
    size_t sz = sizeof(a);
    void *extra[] = {HIP_LAUNCH_PARAM_BUFFER_POINTER, &a, HIP_LAUNCH_PARAM_BUFFER_SIZE, &sz, HIP_LAUNCH_PARAM_END};
    hipStream_t stream = at::cuda::getCurrentCUDAStream();
    hipError_t err;
#ifdef ZYFA_ENABLE_NATIVE_FP8
    if (native)
        err = fmha_fp8_native::launch_d128(a, stream);
    else
#endif
        err = hipModuleLaunchKernel(fn, p->grid, 1, 1, 512, 1, 1, 0, stream, nullptr, extra);
    TORCH_CHECK(err == hipSuccess, native ? "fmha_fp8 d128 native HIP launch: " : "fmha_fp8 asm launch: ",
                hipGetErrorString(err));
    if (return_lse)
        return {O, Lse};
    return {O};
}

std::vector<torch::Tensor> forward(torch::Tensor q, torch::Tensor k, torch::Tensor v, double scale, bool causal,
                                   bool return_lse, bool bshd, double v_scale,
                                   c10::optional<torch::Tensor> q_descale, c10::optional<torch::Tensor> k_descale,
                                   c10::optional<torch::Tensor> v_descale) {
    return forward_impl(q, k, v, scale, causal, return_lse, bshd, v_scale, q_descale, k_descale, v_descale, false);
}

std::vector<torch::Tensor> forward_hip(torch::Tensor q, torch::Tensor k, torch::Tensor v, double scale, bool causal,
                                       bool return_lse, bool bshd, double v_scale,
                                       c10::optional<torch::Tensor> q_descale, c10::optional<torch::Tensor> k_descale,
                                       c10::optional<torch::Tensor> v_descale) {
#ifndef ZYFA_ENABLE_NATIVE_FP8
    TORCH_CHECK(false, "the native HIP FP8 backend was not enabled in this build; rebuild with "
                       "ZYFA_NATIVE_LLVM_ROOT pointing to the compatible LLVM checkout described in "
                       "docs/hip-fp8-isa-match.md");
#endif
    return forward_impl(q, k, v, scale, causal, return_lse, bshd, v_scale, q_descale, k_descale, v_descale, true);
}

}  // namespace fmha_fp8_d128_asm
